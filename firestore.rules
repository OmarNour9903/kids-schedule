rules_version = '2';

// صلاحيات قاعدة البيانات. دي الحماية الحقيقية للسيستم،
// لأن أي حد يقدر يفتح كود الواجهة ويعدل فيه.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // صاحب السيستم: الـ document بتاعه بيتعمل يدوي من Firebase Console بس
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // المستخدم مش متوقف من صاحب السيستم
    function userEnabled() {
      return exists(userPath()) && get(userPath()).data.get('disabled', false) != true;
    }

    function familyEnabled(fid) {
      return get(/databases/$(database)/documents/families/$(fid)).data.get('suspended', false) != true;
    }

    function memberPath(fid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid);
    }

    function isActiveMember(fid) {
      return signedIn() && exists(memberPath(fid))
        && get(memberPath(fid)).data.status == 'active'
        && userEnabled()
        && familyEnabled(fid);
    }

    function hasRole(fid, roles) {
      return isActiveMember(fid) && get(memberPath(fid)).data.role in roles;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // الحقول اللي بتستخدم في المسح الناعم والاستعادة
    function softDeleteKeys() {
      return ['deleted', 'deletedAt', 'deletedBy', 'restoredAt', 'restoredBy'];
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // الدعوة لازم تكون لنفس العيلة ونفس الدور، ماتستخدمتش، ولسه صالحة،
    // وتتعلم إنها اتستخدمت في نفس العملية
    function validInvite(fid, code, role) {
      let inv = get(invitePath(code)).data;
      return inv.familyId == fid
        && inv.role == role
        && inv.usedBy == null
        && request.time < inv.expiresAt
        && getAfter(invitePath(code)).data.usedBy == request.auth.uid;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // بيانات الشخص نفسه. الإيقاف (disabled) يغيّره صاحب السيستم بس
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('disabled', false) == false;
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
        || (isAdmin() && onlyChanged(['disabled', 'disabledAt', 'disabledBy']))
      );

      // إشعاراته: هو بس اللي يقراها ويعلّمها مقروءة،
      // وأي عضو مفعّل في نفس العيلة يقدر يبعتله إشعار باسمه هو
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && onlyChanged(['read']);
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && isActiveMember(request.resource.data.familyId)
          && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(uid))
          && request.resource.data.read == false
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 600;
      }
    }

    match /families/{fid} {
      allow read: if isActiveMember(fid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt']);
      allow update: if (hasRole(fid, ['owner']) && onlyChanged(['name']))
        || (isAdmin() && onlyChanged(['suspended', 'suspendedAt', 'suspendedBy']));

      match /members/{uid} {
        // العضو الموقوف يقدر يقرا عضويته بس، عشان نعرّفه إنه موقوف
        allow get: if signedIn() && (request.auth.uid == uid || isActiveMember(fid) || isAdmin());
        allow list: if isActiveMember(fid) || isAdmin();

        // الانضمام: يا المالك وهو بيعمل العيلة، يا حد معاه دعوة صالحة
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.status == 'active'
          && (
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/families/$(fid)).data.ownerId == request.auth.uid)
            || (request.resource.data.role in ['parent', 'viewer', 'driver']
              && validInvite(fid, request.resource.data.inviteCode, request.resource.data.role))
          );

        // المالك يغير دور أو حالة أي حد غير نفسه،
        // وولي الأمر يوقف أو يفعّل السواقين بس
        allow update: if
          (hasRole(fid, ['owner'])
            && request.auth.uid != uid
            && resource.data.role != 'owner'
            && onlyChanged(['role', 'status', 'updatedAt'])
            && request.resource.data.role in ['parent', 'viewer', 'driver']
            && request.resource.data.status in ['active', 'suspended'])
          || (hasRole(fid, ['parent'])
            && resource.data.role == 'driver'
            && onlyChanged(['status', 'updatedAt'])
            && request.resource.data.status in ['active', 'suspended']);

        allow delete: if false;
      }

      // الأولاد والأماكن: كل الأعضاء يشوفوها، وأولياء الأمر بس يعدلوها.
      // مفيش مسح نهائي: المسح بيبقى deleted = true عشان صاحب السيستم يقدر يرجّعه
      match /children/{childId} {
        allow read: if isActiveMember(fid) || isAdmin();
        allow create, update: if (hasRole(fid, ['owner', 'parent'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40)
          || (isAdmin() && onlyChanged(softDeleteKeys()));
        allow delete: if false;
      }

      match /places/{placeId} {
        allow read: if isActiveMember(fid) || isAdmin();
        allow create, update: if (hasRole(fid, ['owner', 'parent'])
          && request.resource.data.name is string
          && (request.resource.data.lat is number || request.resource.data.lat == null)
          && (request.resource.data.lng is number || request.resource.data.lng == null)
          && (request.resource.data.lat != null || request.resource.data.get('mapsUrl', null) is string))
          || (isAdmin() && onlyChanged(softDeleteKeys()));
        allow delete: if false;
      }

      // المواعيد مابتتمسحش، بتتلغي (cancelled) عشان السجل يفضل موجود
      match /appointments/{appointmentId} {
        allow read: if isActiveMember(fid) || isAdmin();
        allow create, update: if (hasRole(fid, ['owner', 'parent'])
          && request.resource.data.type in ['regular', 'extra', 'travel']
          && request.resource.data.childIds is list
          && request.resource.data.childIds.size() > 0
          && request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.repeatWeekly is bool
          && request.resource.data.cancelled is bool)
          || (isAdmin() && onlyChanged(['cancelled', 'repeatUntil', 'repeatUntilBefore', 'endedByCancel', 'updatedBy', 'updatedAt']));
        allow delete: if false;
      }

      // اللي بيحصل في يوم معين من الموعد: تعديل، إلغاء، تعيين سواق، وحالة المشوار.
      // الـ ID = appointmentId_date
      // أولياء الأمر يعدلوا أي حاجة، والسواق يعدّل حالة المشوار بس
      match /occurrences/{occurrenceId} {
        function idMatches() {
          return occurrenceId == request.resource.data.appointmentId + '_' + request.resource.data.date;
        }
        function validStatus() {
          return request.resource.data.status in ['scheduled', 'confirmed', 'arrived', 'picked', 'done', 'declined'];
        }
        function driverKeys() {
          return ['appointmentId', 'date', 'status', 'statusLog', 'declineReason', 'updatedBy', 'updatedAt'];
        }

        allow read: if isActiveMember(fid) || isAdmin();
        allow create: if idMatches() && (
          hasRole(fid, ['owner', 'parent'])
          || (hasRole(fid, ['driver']) && request.resource.data.keys().hasOnly(driverKeys()) && validStatus())
        );
        allow update: if idMatches() && (
          hasRole(fid, ['owner', 'parent'])
          || (hasRole(fid, ['driver'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(driverKeys())
            && validStatus()
            && (!('driverId' in resource.data) || resource.data.driverId == request.auth.uid))
        );
        allow delete: if false;
      }

      // التعليقات: أي عضو مفعّل يكتب باسمه، وصاحب التعليق بس يمسحه (مسح ناعم)
      match /comments/{commentId} {
        allow read: if isActiveMember(fid) || isAdmin();
        allow create: if isActiveMember(fid)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if (isActiveMember(fid) && resource.data.authorId == request.auth.uid && onlyChanged(softDeleteKeys()))
          || (isAdmin() && onlyChanged(softDeleteKeys()));
        allow delete: if false;
      }
    }

    match /invites/{code} {
      // الكود نفسه هو السر (32 حرف عشوائي)، فاللي معاه اللينك بس يقدر يقراها
      allow get: if true;
      allow list: if signedIn() && hasRole(resource.data.familyId, ['owner']);

      allow create: if signedIn()
        && hasRole(request.resource.data.familyId, ['owner'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.role in ['parent', 'viewer', 'driver'];

      // اللي بيسجل بالدعوة يعلّمها إنها اتستخدمت، في نفس عملية الانضمام
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.time < resource.data.expiresAt
        && onlyChanged(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(request.auth.uid)).data.inviteCode == code;

      allow delete: if signedIn()
        && hasRole(resource.data.familyId, ['owner'])
        && resource.data.usedBy == null;
    }
  }
}
